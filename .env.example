# Copy this file to .env, then set the two required secrets below.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
POSTGRES_DB=linkvault
DB_USERNAME=linkvault
DB_PASSWORD=
JWT_SECRET=
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080

# Keep false for fresh databases. For a verified existing schema without
# Flyway history, enable for one startup only, then set it back to false.
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
